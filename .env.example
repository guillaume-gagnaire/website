# Production license for @nuxt/ui-pro, get one at https://ui.nuxt.com/pro/purchase
NUXT_UI_PRO_LICENSE=
# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# /resume — password required to generate a tailored CV
NUXT_RESUME_PASSWORD=
# OpenAI API key used by /api/resume/generate
NUXT_OPENAI_API_KEY=
# Optional: override the OpenAI model (default: gpt-4o-mini)
NUXT_OPENAI_MODEL=gpt-4o-mini
